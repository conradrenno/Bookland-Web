# Variáveis lidas por src/lib/config.ts. Copie para `.env.local` e ajuste.
# Nenhuma é obrigatória em dev — todas têm default apontando para o Spring local.

# Base da API Bookland (Spring). Usada só no servidor; nunca vai para o browser.
BOOKLAND_API_URL=http://localhost:8080

# Timeout de uma chamada ao upstream, em ms.
BOOKLAND_API_TIMEOUT_MS=10000

# Origem pública das mídias servidas pela API — hoje, capas enviadas por upload,
# gravadas como caminho relativo `/media/covers/{uuid}.jpg`.
#
# Separada de BOOKLAND_API_URL porque este valor é RENDERIZADO NO HTML: precisa
# ser um endereço que o otimizador de imagem do Next alcance. Em dev coincidem.
# Em produção, definir explicitamente — e lembrar de declarar o host em
# `next.config.ts › images.remotePatterns`, senão o next/image derruba a página.
NEXT_PUBLIC_BOOKLAND_MEDIA_URL=http://localhost:8080
