# Variáveis lidas por src/lib/config.ts. Copie para `.env.local` e ajuste.
# Só BOOKLAND_OAUTH_CLIENT_SECRET é obrigatória — as demais têm default apontando
# para o backend local.

# Base da API Bookland — o GATEWAY, que encaminha para a API (:8083) e o
# catálogo (:8082). Usada só no servidor; nunca vai para o browser.
BOOKLAND_API_URL=http://localhost:8080

# Timeout de uma chamada ao upstream, em ms.
BOOKLAND_API_TIMEOUT_MS=10000

# Origem pública das mídias servidas pela API — hoje, capas enviadas por upload,
# gravadas como caminho relativo `/media/covers/{uuid}.jpg` (o gateway roteia
# `/media/**` para o catálogo).
#
# Separada de BOOKLAND_API_URL porque este valor é RENDERIZADO NO HTML: precisa
# ser um endereço que o otimizador de imagem do Next alcance. Em dev coincidem.
# Em produção, definir explicitamente — e lembrar de declarar o host em
# `next.config.ts › images.remotePatterns`, senão o next/image derruba a página.
NEXT_PUBLIC_BOOKLAND_MEDIA_URL=http://localhost:8080

# --- Login (OAuth2) -----------------------------------------------------------
# Serviço de identidade: servidor de autorização, cadastro e conta. NÃO passa
# pelo gateway. 127.0.0.1, não localhost — é o issuer dos tokens.
BOOKLAND_IDENTITY_URL=http://127.0.0.1:9000

# Origem pública deste BFF. Precisa bater com a redirect URI registrada no
# client (`{BFF}/api/auth/callback`). Abra o app por este endereço, não por
# localhost: o cookie do login nasce no host em que o fluxo começou.
BOOKLAND_BFF_URL=http://127.0.0.1:3000

# Client OAuth2 confidencial. O segredo é só do servidor — nunca NEXT_PUBLIC_.
# Perfil dev do backend: `bookland-web-secret`. Stack do compose: o valor de
# OAUTH2_CLIENT_SECRET no `.env` do backend.
BOOKLAND_OAUTH_CLIENT_ID=bookland-web
BOOKLAND_OAUTH_CLIENT_SECRET=
