      "ProblemDetail": {
        "type": "object",
        "description": "RFC 7807 error body. Branch on 'code'; 'detail' is prose and may be reworded at any time. See docs/error-contract.md.",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "default": "about:blank",
            "description": "Omitted while it is about:blank for every error"
          },
          "title": {
            "type": "string",
            "description": "The HTTP reason phrase",
            "example": "Unauthorized"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 401
          },
          "detail": {
            "type": "string",
            "description": "Human-readable; safe to show as a banner, never parse it",
            "example": "The access token has expired"
          },
          "instance": {
            "type": "string",
            "description": "The request path",
            "example": "/api/v1/cart"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable symbol, e.g. TOKEN_EXPIRED, INSUFFICIENT_ROLE, VALIDATION_ERROR, MALFORMED_REQUEST",
            "example": "TOKEN_EXPIRED"
          }
        },
        "required": [
          "status",
          "title",
          "code"
        ]
      },
      "ValidationProblemDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetail"
          },
          {
            "type": "object",
            "properties": {
              "errors": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": "Field name to the messages that field broke. A field can break several constraints, so values are always arrays. Errors belonging to the payload as a whole use the key '_'."
              }
            }
          }
        ],
        "description": "A ProblemDetail carrying the per-field breakdown of a rejected payload"
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Authorization code + PKCE against the Bookland Authorization Server.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://127.0.0.1:9000/oauth2/authorize",
            "tokenUrl": "http://127.0.0.1:9000/oauth2/token",
            "scopes": {
              "openid": "Issue an id_token identifying the user",
              "profile": "Basic profile claims",
              "email": "The user's e-mail claim"
            }
          }
        }
      },
      "bearerAuth": {
        "type": "http",
        "description": "An access token obtained from POST /oauth2/token.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
