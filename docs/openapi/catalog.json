  "components": {
    "schemas": {
      "CreateBookRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "isbn": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0,
            "pattern": "\\s*(?:\\d[\\s-]*){13}"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255,
              "minLength": 0
            },
            "minItems": 1
          },
          "publisher": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "publicationYear": {
            "type": "integer",
            "format": "int32",
            "maximum": 2100,
            "minimum": 1000
          },
          "edition": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "synopsis": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0.01
          },
          "stockQuantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "coverImageUrl": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "authors",
          "categoryId",
          "isbn",
          "price",
          "title"
        ]
      },
      "BookViewModel": {
        "type": "object",
        "properties": {
